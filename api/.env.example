# Database — Neon Postgres connection string
# Get this from your Neon dashboard: https://console.neon.tech
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/taitalumi?sslmode=require

# JWT — generate a random string for dev (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App environment: development | staging | production
APP_ENV=development
