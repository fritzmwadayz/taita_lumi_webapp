{
  "name": "lumi-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "preexport": "node -e \"console.log('[export] snapshotting dictionary from LUMI_API_BASE_URL=' + (process.env.LUMI_API_BASE_URL || 'http://localhost:8000'))\"",
    "export": "node scripts/export-dictionary.mjs",
    "build": "npm run export && nuxt build",
    "build:static": "npm run export && nuxt generate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
