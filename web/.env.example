# ── Lumi (Nuxt) — environment variables ───────────────────────────────────
# Copy this file to `.env` and fill in the values for your local dev.
# In production (Netlify), set these in the Netlify dashboard under
# Site settings → Environment variables.

# ── App secret (session cookie encryption) ────────────────────────────────
# Used by Nuxt + nuxt-auth-utils to seal the session cookie that stores
# the JWT tokens. This is SEPARATE from your FastAPI JWT signing secret.
# Generate one: openssl rand -hex 32
NUXT_APP_SECRET=

# ── API base URL (server-side) ────────────────────────────────────────────
# Where the FastAPI backend lives. In local dev, that's localhost:8000
# (matches the original Vite proxy from the Vue project).
# In production, this is the Render URL.
LUMI_API_BASE_URL=http://localhost:8000

# ── Google OAuth ──────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs for local dev:
#   http://localhost:3000/api/auth/oauth/google
# For production, add:
#   https://your-netlify-domain.netlify.app/api/auth/oauth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ── Public (browser-visible) ─────────────────────────────────────────────
# Leave empty — the browser calls same-origin /api/* and Nitro proxies.
NUXT_PUBLIC_API_BASE=

# ── Nitro preset (production only) ────────────────────────────────────────
# Netlify auto-detects Nuxt and sets this. For local production builds:
# NITRO_PRESET=netlify
