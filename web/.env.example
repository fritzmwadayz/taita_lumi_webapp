# API base URL — leave empty in dev (Vite proxies /api/* to localhost:8000)
# In production, set to your deployed API URL, e.g.:
# VITE_API_BASE_URL=https://taitalumi-api.onrender.com
VITE_API_BASE_URL=

# Google OAuth Client ID — from https://console.cloud.google.com/apis/credentials
# Must match the GOOGLE_OAUTH_CLIENT_ID on the backend.
# Leave empty to disable Google sign-in (email/password still works).
VITE_GOOGLE_CLIENT_ID=
